generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Analysis {
  // uuid() default is a type-level placeholder only — lib/prisma.ts always
  // supplies a nanoid before the value reaches the database.
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  filename     String
  country      String
  contractText String
  result       Json?
  overallRisk  String?
  // "processing" | "completed" | "failed" — only meaningfully "processing" or
  // "failed" for rows created by the fire-and-forget comparison flow; rows
  // created once their analysis is already in hand default to "completed".
  status       String  @default("completed")
  errorMessage String?

  comparisonGroupId String?
  comparisonGroup   ComparisonGroup? @relation(fields: [comparisonGroupId], references: [id])

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id])
}

model ComparisonGroup {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  filename  String
  countries String[]

  analyses Analysis[]
}

model Batch {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name       String?
  country    String
  totalFiles Int
  status     String

  analyses Analysis[]
}
